<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xingleme.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lime_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lime_container</item>
        <item name="colorOnPrimaryContainer">@color/lime_deep</item>
        <item name="colorSecondary">@color/lime_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/lime_container</item>
        <item name="colorOnSecondaryContainer">@color/lime_deep</item>
        <item name="colorTertiary">@color/lime_primary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/icon_tile</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/lime_page</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="android:windowBackground">@color/lime_page</item>
        <item name="android:navigationBarColor">@color/lime_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:colorAccent">@color/lime_primary</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Theme.Xingleme" parent="Theme.Xingleme.Base" />

    <style name="Theme.Xingleme.Mint" parent="Theme.Xingleme.Base">
        <item name="colorPrimary">@color/mint_primary</item>
        <item name="colorPrimaryContainer">@color/mint_container</item>
        <item name="colorOnPrimaryContainer">@color/mint_deep</item>
        <item name="colorSecondary">@color/mint_primary</item>
        <item name="colorSecondaryContainer">@color/mint_container</item>
        <item name="colorOnSecondaryContainer">@color/mint_deep</item>
        <item name="colorTertiary">@color/mint_primary</item>
        <item name="android:colorBackground">@color/mint_page</item>
        <item name="android:windowBackground">@color/mint_page</item>
        <item name="android:navigationBarColor">@color/mint_page</item>
        <item name="android:colorAccent">@color/mint_primary</item>
    </style>

    <style name="Theme.Xingleme.Orange" parent="Theme.Xingleme.Base">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryContainer">@color/orange_container</item>
        <item name="colorOnPrimaryContainer">@color/orange_deep</item>
        <item name="colorSecondary">@color/orange_primary</item>
        <item name="colorSecondaryContainer">@color/orange_container</item>
        <item name="colorOnSecondaryContainer">@color/orange_deep</item>
        <item name="colorTertiary">@color/orange_primary</item>
        <item name="android:colorBackground">@color/orange_page</item>
        <item name="android:windowBackground">@color/orange_page</item>
        <item name="android:navigationBarColor">@color/orange_page</item>
        <item name="android:colorAccent">@color/orange_primary</item>
    </style>

    <style name="Theme.Xingleme.Blue" parent="Theme.Xingleme.Base">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryContainer">@color/blue_container</item>
        <item name="colorOnPrimaryContainer">@color/blue_deep</item>
        <item name="colorSecondary">@color/blue_primary</item>
        <item name="colorSecondaryContainer">@color/blue_container</item>
        <item name="colorOnSecondaryContainer">@color/blue_deep</item>
        <item name="colorTertiary">@color/blue_primary</item>
        <item name="android:colorBackground">@color/blue_page</item>
        <item name="android:windowBackground">@color/blue_page</item>
        <item name="android:navigationBarColor">@color/blue_page</item>
        <item name="android:colorAccent">@color/blue_primary</item>
    </style>

    <style name="Theme.Xingleme.Cherry" parent="Theme.Xingleme.Base">
        <item name="colorPrimary">@color/cherry_primary</item>
        <item name="colorPrimaryContainer">@color/cherry_container</item>
        <item name="colorOnPrimaryContainer">@color/cherry_deep</item>
        <item name="colorSecondary">@color/cherry_primary</item>
        <item name="colorSecondaryContainer">@color/cherry_container</item>
        <item name="colorOnSecondaryContainer">@color/cherry_deep</item>
        <item name="colorTertiary">@color/cherry_primary</item>
        <item name="android:colorBackground">@color/cherry_page</item>
        <item name="android:windowBackground">@color/cherry_page</item>
        <item name="android:navigationBarColor">@color/cherry_page</item>
        <item name="android:colorAccent">@color/cherry_primary</item>
    </style>

    <style name="Theme.Xingleme.Transparent" parent="Theme.Xingleme.Base">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
