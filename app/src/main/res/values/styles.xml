<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Xingleme.Section" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Xingleme.SectionSub" parent="">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Xingleme.CardTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Xingleme.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Xingleme.Caption" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Xingleme.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipCornerRadius">19dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Xingleme.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Xingleme.IconTile" parent="">
        <item name="android:background">@drawable/bg_icon_tile</item>
    </style>
</resources>
